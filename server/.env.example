# Google Gemini API via Google AI Studio REST generateContent.
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyDBmYlJD2MBAuGWbovfsMbKMIPKreQPslI
GEMINI_MODEL=gemini-1.5-flash

# Gemini 2.0 Flash was shut down by Google on 2026-06-01.
# If your API project still exposes another Flash model, set it here:
# GEMINI_MODEL=gemini-2.0-flash

# Optional. Defaults to Google's v1beta Gemini endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional. OpenAI-compatible fallback, for OpenAI/OpenRouter/etc.
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional. Set to 0 to force the original local bot logic.
# LLM_BOT_ENABLED=1

# Optional. Keep this low so bot turns do not feel stalled.
# LLM_BOT_TIMEOUT_MS=2500

# Optional. Logs model choices and reasons on the server.
# LLM_BOT_DEBUG=1
